{
  "expo": {
    "name": "Tzerachìa",
    "slug": "tzerachia",
    "scheme": "tzerachia",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/iconTzerachia.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tzerachia.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tzerachia.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/iconTzerachia.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Consenti a Tzerachia di usare la fotocamera per sincronizzare."
        }
      ],
      "expo-notifications",
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "5d8f7bd2-e233-4165-b612-9c1aa02f36ce"
      }
    }
  }
}
